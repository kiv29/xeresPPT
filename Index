.skin-pastel .cols .col:nth-child(1){background:#F0E4F7;border-color:transparent}.skin-pastel .cols .col:nth-child(2){background:#FDE8D6;border-color:transparent}.skin-pastel .cols .col:nth-child(3){background:#E2F3EA;border-color:transparent}.skin-pastel .cols .col:nth-child(4){background:#DFEAF6;border-color:transparent}
