/* 粉彩：深色頁也走淺底（參考站幾乎全淺），波形線放右側 */
.skin-pastel .slide.dark{background:var(--bg);color:var(--ink)}
.skin-pastel .slide.dark .head,.skin-pastel .slide.dark .foot,.skin-pastel .slide.dark .label,.skin-pastel .slide.dark .lead,.skin-pastel .slide.dark .attr,.skin-pastel .slide.dark .cta-note{color:var(--mute);border-color:var(--line)}
.skin-pastel .slide.dark .cta-btn{background:var(--ink);color:var(--bg)}
.skin-pastel .slide.dark .h1 em,.skin-pastel .slide.dark .h2 em{color:transparent}
