.bloom{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.bloom i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.75}
.bloom i:nth-child(1){width:760px;height:520px;left:-120px;top:32%;background:#F5A623}
.bloom i:nth-child(2){width:700px;height:560px;left:32%;top:38%;background:#FF6B9A}
