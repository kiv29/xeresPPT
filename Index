<title>2027 流年運勢自己看</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..700&family=Instrument+Sans:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;900&family=Instrument+Serif&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">

<!-- ═══════════════════════════════════════════════════════════════
     簡報工廠 · 簡報範本 v2
     六套皮膚內建，改最下面 DECK.skin 就切換（播放時按 S 也能輪流看）：
       "greige"   灰調機構：暖灰米底、寬體無襯線、半色調點陣、髮絲線、炭灰深頁
       "midnight" 午夜霧光：奶油底、霧化深色漸層、人文無襯線、逐字浮現
       "aurora"   極光：靛紫光暈、白色圓角區塊、玻璃感
       "pastel"   粉彩研究：暖奶油、漸層字、四色粉彩卡、波形線
       "bloom"    柔光：奶油底、襯線標題、彩色霧暈
       "sky"      天光：天空藍漸層、封面照片位、玻璃導覽
     其餘：只動 DECK 內容清單。引擎不碰。
     ═══════════════════════════════════════════════════════════════ -->
<style>
/* ────────── 皮膚 A：灰調機構 ────────── */
.skin-greige{
  --bg:#EDEAE5;--bg2:#E4E0DA;--card:#F3F1ED;
  --ink:#1E1916;--ink2:#332D2D;--mute:#7C756F;--sand:#CBC4BC;
  --dark:#332D2D;--dark2:#1E1916;--onDark:#EDEAE5;--onDarkMute:#A79F96;
  --accent:#585540;
  --line:rgba(30,25,22,.14);--lineDark:rgba(237,234,229,.16);
  --display:'Archivo','Noto Sans TC',sans-serif;--body:'Archivo','Noto Sans TC',sans-serif;--tc:'Noto Sans TC',sans-serif;
  --dw:125;--dwt:600;--radius:14px;--pill:999px;
}
/* ────────── 皮膚 B：午夜霧光 ────────── */
.skin-midnight{
  --bg:#F3F0E9;--bg2:#ECE8E0;--card:#FAF8F3;
  --ink:#1B1E20;--ink2:#352E32;--mute:#7C726C;--sand:#C9C8C5;
  --dark:#1B1F2E;--dark2:#12141C;--onDark:#F3F0E9;--onDarkMute:#B9B3AD;
  --accent:#5D4F54;
  --line:rgba(27,30,32,.12);--lineDark:rgba(243,240,233,.14);
  --display:'Instrument Sans','Noto Sans TC',sans-serif;--body:'Instrument Sans','Noto Sans TC',sans-serif;--tc:'Noto Sans TC',sans-serif;
  --dw:100;--dwt:600;--radius:20px;--pill:999px;
}

/* ────────── 皮膚 C：極光（onefin）：靛紫光暈、玻璃面板、白色圓角區塊 ────────── */
.skin-aurora{
  --bg:#F6F5FF;--bg2:#FFFFFF;--card:#FFFFFF;
  --ink:#12103A;--ink2:#2E2B5E;--mute:#6F6C9A;--sand:#C7C2FF;
  --dark:#2A1EBF;--dark2:#150F6B;--onDark:#FFFFFF;--onDarkMute:#D9D5FF;
  --accent:#4B3BFF;
  --line:rgba(18,16,58,.1);--lineDark:rgba(255,255,255,.22);
  --display:'Instrument Sans','Noto Sans TC',sans-serif;--body:'Instrument Sans','Noto Sans TC',sans-serif;--tc:'Noto Sans TC',sans-serif;
  --dw:100;--dwt:600;--radius:28px;--pill:999px;
}
/* ────────── 皮膚 D：粉彩研究（hume）：暖奶油、漸層字、四色粉彩卡、波形線 ────────── */
.skin-pastel{
  --bg:#FBF7F2;--bg2:#F6F1EA;--card:#FFFFFF;
  --ink:#1C1B1F;--ink2:#3A3840;--mute:#7A7780;--sand:#E7D9F2;
  --dark:#151419;--dark2:#0B0A0D;--onDark:#FBF7F2;--onDarkMute:#B8B3C2;
  --accent:#E59BD6;
  --line:rgba(28,27,31,.1);--lineDark:rgba(251,247,242,.16);
  --display:'Instrument Sans','Noto Sans TC',sans-serif;--body:'Instrument Sans','Noto Sans TC',sans-serif;--tc:'Noto Sans TC',sans-serif;
  --dw:100;--dwt:500;--radius:22px;--pill:999px;
}
/* ────────── 皮膚 E：柔光（liftoff）：奶油底、編輯體襯線標題、彩色霧光暈 ────────── */
.skin-bloom{
  --bg:#FBF8F3;--bg2:#F5F1EA;--card:#FFFFFF;
  --ink:#171A24;--ink2:#343849;--mute:#767A8A;--sand:#F3C9B5;
  --dark:#171A24;--dark2:#0E1018;--onDark:#FBF8F3;--onDarkMute:#B7BAC7;
  --accent:#F27A2C;
  --line:rgba(23,26,36,.1);--lineDark:rgba(251,248,243,.16);
  --display:'Instrument Serif','Noto Serif TC',serif;--body:'Instrument Sans','Noto Sans TC',sans-serif;--tc:'Noto Serif TC',serif;
  --dw:100;--dwt:400;--radius:24px;--pill:999px;
}
/* ────────── 皮膚 F：天光（alveos）：天空藍漸層、全幅照片位、玻璃導覽 ────────── */
.skin-sky{
  --bg:#DCE7F5;--bg2:#E9F0F8;--card:rgba(255,255,255,.55);
  --ink:#10233A;--ink2:#2B3F58;--mute:#5F7390;--sand:#B9CCE3;
  --dark:#3F6EA6;--dark2:#1E3A5F;--onDark:#FFFFFF;--onDarkMute:#D6E3F2;
  --accent:#10233A;
  --line:rgba(16,35,58,.12);--lineDark:rgba(255,255,255,.28);
  --display:'Instrument Sans','Noto Sans TC',sans-serif;--body:'Instrument Sans','Noto Sans TC',sans-serif;--tc:'Noto Sans TC',sans-serif;
  --dw:100;--dwt:500;--radius:26px;--pill:999px;
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;background:#0f0f0e;overflow:hidden}
body{font-family:var(--body);color:var(--ink);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
::selection{background:var(--sand);color:var(--ink)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

#wrap{position:fixed;inset:0;overflow:hidden}
#stage{position:absolute;top:50%;left:50%;width:1920px;height:1080px;transform-origin:center;box-shadow:0 60px 140px rgba(0,0,0,.6);background:var(--bg)}
.slide{position:absolute;inset:0;padding:96px 120px;display:flex;flex-direction:column;opacity:0;visibility:hidden;transition:opacity .4s ease;background:var(--bg);overflow:hidden}
.slide.on{opacity:1;visibility:visible;z-index:2}
.slide.alt{background:var(--bg2)}
.slide.dark{background:var(--dark);color:var(--onDark)}

/* 頂欄與底欄：髮絲線＋小字 */
.head{position:absolute;left:120px;right:120px;top:52px;display:flex;justify-content:space-between;align-items:center;font-family:var(--body);font-size:15px;letter-spacing:.06em;text-transform:uppercase;color:var(--mute);padding-bottom:18px;border-bottom:1px solid var(--line)}
.slide.dark .head{color:var(--onDarkMute);border-color:var(--lineDark)}
.head .brand{font-weight:500}
.foot{position:absolute;left:120px;right:120px;bottom:52px;display:flex;justify-content:space-between;align-items:flex-end;font-size:14px;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
.slide.dark .foot{color:var(--onDarkMute)}
#bar{position:absolute;left:0;bottom:0;height:3px;background:var(--ink);width:0;transition:width .4s;z-index:9}

/* 進場 */
.slide.on .a{animation:rise .9s cubic-bezier(.16,1,.3,1) both}
.slide.on .a:nth-child(2){animation-delay:.1s}.slide.on .a:nth-child(3){animation-delay:.2s}.slide.on .a:nth-child(4){animation-delay:.3s}.slide.on .a:nth-child(5){animation-delay:.4s}.slide.on .a:nth-child(6){animation-delay:.5s}.slide.on .a:nth-child(7){animation-delay:.6s}
@keyframes rise{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}
/* 午夜：逐字浮現 */
.w{display:inline-block;opacity:.18;transition:opacity .5s ease}
.slide.on .w{opacity:1}

/* 字 */
.label{font-family:var(--body);font-size:16px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);font-weight:500;margin-bottom:30px;display:flex;align-items:center;gap:14px}
.label::before{content:"";width:28px;height:1px;background:currentColor;opacity:.6}
.slide.dark .label{color:var(--onDarkMute)}
.h1{font-family:var(--display);font-variation-settings:"wdth" var(--dw),"wght" var(--dwt);font-weight:var(--dwt);font-size:116px;line-height:1.02;letter-spacing:-.025em;max-width:1460px}
.h1 .tc,.h2 .tc,.quote .tc{font-family:var(--tc);font-weight:700;letter-spacing:0;line-height:1.12}
.h1 em,.h2 em{font-style:normal;color:var(--mute)}
.slide.dark .h1 em,.slide.dark .h2 em{color:var(--onDarkMute)}
.h2{font-family:var(--display);font-variation-settings:"wdth" var(--dw),"wght" var(--dwt);font-weight:var(--dwt);font-size:84px;line-height:1.04;letter-spacing:-.02em;max-width:1400px}
.lead{margin-top:34px;font-size:28px;line-height:1.55;color:var(--ink2);max-width:880px;font-weight:400}
.slide.dark .lead{color:var(--onDarkMute)}
.center{flex:1;display:flex;flex-direction:column;justify-content:center;position:relative;z-index:1}
.two{display:grid;grid-template-columns:1.1fr .9fr;gap:80px;align-items:end}
.two .desc{font-size:22px;line-height:1.6;color:var(--mute);max-width:520px;padding-bottom:10px}
.slide.dark .two .desc{color:var(--onDarkMute)}

/* 列點：編號＋髮絲線 */
.points{list-style:none;margin-top:52px;max-width:1300px;border-top:1px solid var(--line)}
.slide.dark .points{border-color:var(--lineDark)}
.points li{display:grid;grid-template-columns:90px 1fr;gap:20px;padding:26px 0;border-bottom:1px solid var(--line);align-items:baseline}
.slide.dark .points li{border-color:var(--lineDark)}
.points li .n{font-size:16px;letter-spacing:.08em;color:var(--mute);font-weight:500}
.slide.dark .points li .n{color:var(--onDarkMute)}
.points li .t{font-family:var(--tc);font-size:34px;font-weight:700;line-height:1.3}
.points li .t small{display:block;font-family:var(--body);font-size:20px;font-weight:400;color:var(--mute);margin-top:6px;letter-spacing:0}
.slide.dark .points li .t small{color:var(--onDarkMute)}

/* 大數字 */
.stat{font-family:var(--display);font-variation-settings:"wdth" var(--dw),"wght" 600;font-weight:600;font-size:360px;line-height:.9;letter-spacing:-.05em}
.stat-label{font-size:30px;line-height:1.5;color:var(--ink2);margin-top:30px;max-width:900px}
.slide.dark .stat-label{color:var(--onDarkMute)}

/* 金句 */
.quote{font-family:var(--display);font-variation-settings:"wdth" var(--dw),"wght" 500;font-weight:500;font-size:78px;line-height:1.16;letter-spacing:-.02em;max-width:1500px}
.quote .tc{font-weight:500}
.attr{margin-top:44px;font-size:16px;letter-spacing:.1em;text-transform:uppercase;color:var(--onDarkMute);display:flex;align-items:center;gap:14px}
.attr::before{content:"";width:28px;height:1px;background:currentColor;opacity:.6}

/* 卡片 */
.cols{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:56px}
.col{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:36px 34px 34px;min-height:400px;display:flex;flex-direction:column;position:relative;overflow:hidden}
.slide.dark .col{background:rgba(255,255,255,.05);border-color:var(--lineDark)}
.col .n{font-size:14px;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);font-weight:500;padding-bottom:16px;border-bottom:1px solid var(--line);margin-bottom:22px}
.col .t{font-family:var(--tc);font-weight:700;font-size:40px;line-height:1.2;margin-bottom:16px}
.col .d{font-size:21px;line-height:1.6;color:var(--ink2)}
.col ul{list-style:none;margin-top:auto;padding-top:20px}
.col ul li{font-size:20px;line-height:1.75;color:var(--ink2);padding-left:22px;position:relative}
.col ul li::before{content:"";position:absolute;left:0;top:.8em;width:10px;height:1px;background:var(--mute)}

/* 步驟 */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:56px}
.step{border-top:1px solid var(--ink);padding-top:22px;min-height:300px;position:relative}
.slide.dark .step{border-color:var(--onDark)}
.step .num{font-family:var(--display);font-variation-settings:"wdth" var(--dw),"wght" 600;font-weight:600;font-size:22px;letter-spacing:.02em;color:var(--mute)}
.step .t{font-family:var(--tc);font-weight:700;font-size:36px;line-height:1.2;margin-top:70px}
.step .d{font-size:20px;line-height:1.6;color:var(--mute);margin-top:12px}
.step .dots{position:absolute;right:0;top:22px;width:64px;height:64px;opacity:.85}

/* 對比 */
.vs{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:56px}
.vs .box{border-radius:var(--radius);padding:52px 48px;min-height:420px;display:flex;flex-direction:column;justify-content:space-between;border:1px solid var(--line);background:var(--card)}
.vs .box.r{background:var(--dark);color:var(--onDark);border-color:transparent;position:relative;overflow:hidden}
.vs .k{font-size:15px;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);font-weight:500}
.vs .box.r .k{color:var(--onDarkMute)}
.vs .big{font-family:var(--display);font-variation-settings:"wdth" var(--dw),"wght" 600;font-weight:600;font-size:200px;line-height:.9;letter-spacing:-.05em;margin:30px 0 20px}
.vs .box.l .big{color:var(--sand)}
.vs .lab{font-size:24px;line-height:1.5;max-width:520px}
.vs .box.l .lab{color:var(--mute)}

/* 圖片 */
.figure{margin-top:48px;border-radius:var(--radius);overflow:hidden;background:var(--bg2);border:1px solid var(--line);max-height:620px;display:flex;align-items:center;justify-content:center;position:relative}
.figure img{max-width:100%;max-height:620px;display:block}
.figure .ph{padding:110px;font-size:16px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);text-align:center}

/* 行動頁 */
.cta-btn{display:inline-flex;align-items:center;gap:16px;margin-top:52px;background:var(--onDark);color:var(--dark2);font-family:var(--body);font-weight:500;font-size:24px;padding:22px 40px;border-radius:var(--pill);text-decoration:none;transition:transform .35s cubic-bezier(.16,1,.3,1),background .3s}
.cta-btn::after{content:"→";font-size:22px}
.cta-btn:hover{transform:translateX(4px)}
.slide:not(.dark) .cta-btn{background:var(--ink);color:var(--bg)}
.cta-note{margin-top:22px;font-size:16px;letter-spacing:.08em;text-transform:uppercase;color:var(--onDarkMute)}
.slide:not(.dark) .cta-note{color:var(--mute)}


/* ────────── 動態圖解（motion graphic 輔助說明） ────────── */
.diagram{margin-top:52px;width:100%;height:520px;position:relative}
.diagram svg{width:100%;height:100%;overflow:visible}
.diagram .node{transform-origin:center;transform-box:fill-box;opacity:0}
.diagram .lk{stroke-dasharray:600;stroke-dashoffset:600;fill:none}
.diagram .lbl{opacity:0}
.slide.on .diagram .node{animation:dgPop .7s cubic-bezier(.34,1.56,.64,1) both}
.slide.on .diagram .lk{animation:dgDraw 1s cubic-bezier(.16,1,.3,1) both}
.slide.on .diagram .lbl{animation:rise .7s cubic-bezier(.16,1,.3,1) both}
.slide.on .diagram .orb{animation:dgOrbit 18s linear infinite;transform-origin:center;transform-box:fill-box}
.slide.on .diagram .pulse{animation:dgPulse 2.6s ease-in-out infinite}
@keyframes dgPop{from{opacity:0;transform:scale(.4)}to{opacity:1;transform:scale(1)}}
@keyframes dgDraw{to{stroke-dashoffset:0}}
@keyframes dgOrbit{to{transform:rotate(360deg)}}
@keyframes dgPulse{0%,100%{opacity:.35}50%{opacity:1}}
.diagram text{font-family:var(--tc);fill:currentColor}
.diagram .t1{font-size:30px;font-weight:700}
.diagram .t2{font-size:19px;opacity:.7}
.diagram .num{font-family:var(--display);font-variation-settings:"wdth" var(--dw),"wght" 600;font-size:26px;font-weight:600}
.diagram .bar{opacity:0;transform-origin:left center;transform-box:fill-box}
.slide.on .diagram .bar{animation:dgGrow 1.1s cubic-bezier(.16,1,.3,1) both}
@keyframes dgGrow{from{opacity:0;transform:scaleX(0)}to{opacity:1;transform:scaleX(1)}}
/* ────────── 圖像模組 ────────── */
/* 半色調點球（灰調） */
.halftone{position:absolute;right:120px;top:50%;transform:translateY(-50%);width:640px;height:640px;pointer-events:none}
.halftone circle{fill:currentColor;transform-origin:center;transform-box:fill-box}
.slide.on .halftone circle{animation:pulse 3.2s ease-in-out infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(.72)}}
/* 抖動直線條（灰調） */
.dither{position:absolute;left:120px;right:120px;bottom:150px;height:220px;pointer-events:none;background:repeating-linear-gradient(90deg,currentColor 0 3px,transparent 3px 9px);-webkit-mask-image:linear-gradient(90deg,transparent,#000 35%,#000 65%,transparent);mask-image:linear-gradient(90deg,transparent,#000 35%,#000 65%,transparent);opacity:.35}
.slide.on .dither{animation:ditherIn 1.4s cubic-bezier(.16,1,.3,1) both}
@keyframes ditherIn{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}
/* 霧光（午夜） */
.bokeh{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.bokeh i{position:absolute;border-radius:50%;filter:blur(70px);opacity:.85;will-change:transform}
.bokeh i:nth-child(1){width:900px;height:900px;left:-200px;top:-300px;background:#5D4F54}
.bokeh i:nth-child(2){width:760px;height:760px;right:-160px;top:-200px;background:#282A3B}
.bokeh i:nth-child(3){width:700px;height:700px;left:38%;bottom:-360px;background:#817264}
.bokeh i:nth-child(4){width:520px;height:520px;right:22%;bottom:-120px;background:#352E32}
.slide.on .bokeh i{animation:drift 14s ease-in-out infinite alternate}
.slide.on .bokeh i:nth-child(2){animation-duration:17s}.slide.on .bokeh i:nth-child(3){animation-duration:20s}.slide.on .bokeh i:nth-child(4){animation-duration:12s}
@keyframes drift{from{transform:translate(0,0) scale(1)}to{transform:translate(70px,-50px) scale(1.12)}}
.grainlayer{position:absolute;inset:0;pointer-events:none;opacity:.35;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/></svg>");mix-blend-mode:overlay}
/* 極光（aurora）：靛紫光暈＋玻璃；中文標題配超明體感的粗宋 */
.skin-aurora .h1 .tc,.skin-aurora .h2 .tc,.skin-aurora .quote .tc{font-family:'Noto Serif TC',serif;font-weight:900;font-variation-settings:normal;letter-spacing:.01em}
.skin-aurora .col .t,.skin-aurora .points li .t,.skin-aurora .step .t{font-family:'Noto Serif TC',serif;font-weight:900}
/* 極光（aurora）：靛紫光暈＋玻璃 */
.glow{position:absolute;inset:0;pointer-events:none;overflow:hidden;background:radial-gradient(900px 620px at 70% 20%,#8A6BFF 0%,rgba(138,107,255,0) 60%),radial-gradient(800px 700px at 25% 85%,#3B2BE0 0%,rgba(59,43,224,0) 62%),radial-gradient(600px 500px at 85% 80%,#FF7AD9 0%,rgba(255,122,217,0) 60%),linear-gradient(180deg,#2A1EBF,#150F6B)}
.slide.on .glow{animation:glowdrift 12s ease-in-out infinite alternate}
@keyframes glowdrift{from{background-position:0 0,0 0,0 0,0 0}to{background-position:60px -40px,-40px 40px,30px 30px,0 0}}
.skin-aurora .slide.dark{background:transparent}
.skin-aurora .col,.skin-aurora .vs .box.l,.skin-aurora .figure{box-shadow:0 30px 70px -40px rgba(42,30,191,.35)}
.skin-aurora .cta-btn{background:linear-gradient(180deg,#5B4BFF,#3A2AE8)!important;color:#fff!important;box-shadow:0 14px 34px -14px rgba(59,43,224,.7)}
/* 粉彩（pastel）：漸層字、波形線、四色卡 */
.skin-pastel .h1 em,.skin-pastel .h2 em{background:linear-gradient(90deg,#C9A4F2,#F2A7D1,#F5B98B);-webkit-background-clip:text;background-clip:text;color:transparent}
.waves{position:absolute;left:120px;right:120px;bottom:130px;height:260px;pointer-events:none;opacity:.9}
.waves path{fill:none;stroke-width:1.2;stroke-dasharray:2600;stroke-dashoffset:2600}
