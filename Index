    cycle:'<path d="M38 18A16 16 0 0 0 9 20"/><path d="M10 30a16 16 0 0 0 29-2"/><path d="M38 8v10H28"/><path d="M10 40V30h10"/>'
  };
  const ico=k=>`<svg class="ico" viewBox="0 0 48 48">${IC[k]||''}</svg>`;
  /* 1 到 9 的神聖幾何：1 圓心、2 雙圓、3 三角、4 方、5 到 9 星形 */
  const geo=(n,cls='')=>{const c=200,r=170;const pt=i=>{const a=-Math.PI/2+i*2*Math.PI/n;return [c+r*Math.cos(a),c+r*Math.sin(a)]};let p='';
    if(n==1)p=`<circle class="gl" cx="${c}" cy="${c}" r="90"/><circle cx="${c}" cy="${c}" r="8" style="fill:currentColor"/>`;
    else if(n==2)p=`<circle class="gl" cx="${c-55}" cy="${c}" r="110"/><circle class="gl" cx="${c+55}" cy="${c}" r="110"/>`;
    else{const step={3:1,4:1,5:2,6:2,7:3,8:3,9:4}[n];if(n==6){const a=[0,2,4].map(pt),b=[1,3,5].map(pt);p=`<polygon class="gl" points="${a.join(' ')}"/><polygon class="gl" points="${b.join(' ')}"/>`}else{let seq=[],i=0;do{seq.push(pt(i));i=(i+step)%n}while(i!==0);p=`<polygon class="gl" points="${seq.join(' ')}"/>`}
      for(let i=0;i<n;i++){const [x,y]=pt(i);p+=`<circle cx="${x}" cy="${y}" r="5" style="fill:currentColor"/>`}}
    return `<div class="geo ${cls}"><svg viewBox="0 0 400 400"><g class="spin"><circle cx="${c}" cy="${c}" r="${r+14}" opacity=".5"/>${p}</g></svg></div>`};
  const LIGHT={黃:1,白:1,米:1,金:1,粉:1};const DC=k=>k==='白'?'#BDB6AC':(CL[k]||EL[k]);
  const chip=e=>CL[e]?`<span class="chip" style="background:${CL[e]};color:${LIGHT[e]?'#1D1D1F':'#fff'};border:1px solid var(--line)">代表色 · ${e}</span>`:`<span class="chip" style="background:${EL[e]}">${ico(e)}${e}</span>`;
  const sws=a=>(a||[]).map(k=>`<span class="sw" style="background:${CL[k]||k}${k==='白'?';border-color:#BDB6AC':''}"></span>`).join('');
  const cell=v=>{if(v&&typeof v==='object'){if(v.el)return `<span class="elc" style="color:${EL[v.el]}">${ico(v.el)}${v.el}</span>`;if(v.sw)return sws(v.sw)+esc(v.t||'')}return esc(v)};
  const deco=s=>s.geo?`<div class="geo-deco">${geo(s.geo)}</div>`:'';

  const _stat=R.stat,_quote=R.quote,_cover=R.cover,_cta=R.cta;
  Object.assign(R,{
    stat:s=>deco(s)+_stat(s),
    quote:s=>deco(s)+_quote(s),
    cover:s=>`<div class="geo-deco" style="opacity:.14">${geo(9)}</div>`+_cover(s),
    cta:s=>`<div class="geo-deco" style="opacity:.12">${geo(1)}</div>`+_cta(s),
    year:s=>`<div class="label a" style="position:relative;z-index:1;margin-top:60px;margin-bottom:0">${esc(s.label)}</div><div class="yr"><div class="yr-l a">${geo(s.n)}<div class="yr-num">${s.n}</div><div class="yr-name">${esc(s.name)}</div>${chip(s.el)}<div class="yr-kw">${s.kw.map(k=>`<span>${esc(k)}</span>`).join('')}</div></div><div class="yr-r">${[['up','機會',s.chance],['warn','要小心',s.care],['check','適合做',s.todo]].map((r,i)=>`<div class="yr-row a" style="animation-delay:${.25+i*.12}s"><div class="k">${ico(r[0])}${r[1]}</div><ul>${r[2].map(x=>`<li>${esc(x)}</li>`).join('')}</ul></div>`).join('')}<div class="yr-line a" style="animation-delay:.7s">${esc(s.line)}</div></div></div>`,
    luck:s=>`<div class="center"><div class="label a">${esc(s.label)}</div><h2 class="h2 a" style="font-size:68px">${T(s.title)}</h2><div class="lk-top" style="grid-template-columns:repeat(${s.under?3:2},1fr)">${[['sun',s.under?'代表色':'代表色 · 能量不足時補強',s.main],['cycle','能量太旺時 · 調和',s.over]].concat(s.under?[['up','能量不足時 · 補強',s.under]]:[]).map((c,i)=>`<div class="lk-card a" style="animation-delay:${.2+i*.1}s"><div class="k">${ico(c[0])}${c[1]}</div><div class="lk-sw">${c[2].c.map(k=>`<i style="background:${CL[k]||k}${k==='白'?';border-color:#BDB6AC':''}"></i>`).join('')}</div><div class="nm">${esc(c[2].name)}</div><div class="why">${esc(c[2].why||'')}</div></div>`).join('')}</div><div class="lk-bot">${[['shirt','穿搭',s.wear],['gem','飾品',s.acc],['sun','生活',s.life],['home','居家',s.home]].map((c,i)=>`<div class="lk-it a" style="animation-delay:${.5+i*.08}s"><div class="k">${ico(c[0])}${c[1]}</div><div class="d">${esc(c[2])}</div></div>`).join('')}</div></div>`,
    table:s=>`<div class="center"><div class="label a">${esc(s.label)}</div><h2 class="h2 a" style="font-size:64px">${T(s.title)}</h2><table class="tbl a ${s.dense?'dense':''}"><tr>${s.head.map(h=>`<th>${esc(h)}</th>`).join('')}</tr>${s.rows.map(r=>`<tr>${r.map(v=>`<td>${cell(v)}</td>`).join('')}</tr>`).join('')}</table>${s.note?`<div class="cta-note a" style="margin-top:20px">${esc(s.note)}</div>`:''}</div>`,
    cols:s=>`<div class="center"><div class="label a">${esc(s.label)}</div><h2 class="h2 a">${T(s.title)}</h2><div class="cols" style="grid-template-columns:repeat(${(s.cols||[]).length},1fr)">${(s.cols||[]).map((c,i)=>`<div class="col a" style="animation-delay:${.25+i*.1}s;min-height:360px">${c.icon?`<div class="ci">${ico(c.icon)}</div>`:''}<div class="n">${esc(c.n)}</div><div class="t">${esc(c.t)}</div>${c.items?`<ul>${c.items.map(x=>`<li>${esc(x)}</li>`).join('')}</ul>`:`<div class="d">${esc(c.d)}</div>`}</div>`).join('')}</div></div>`,
    steps:s=>`<div class="center"><div class="label a">${esc(s.label)}</div><h2 class="h2 a">${T(s.title)}</h2><div class="steps" style="grid-template-columns:repeat(${(s.steps||[]).length},1fr)">${(s.steps||[]).map((st,i)=>`<div class="step a" style="animation-delay:${.25+i*.12}s"><div class="num">0${i+1}</div>${st.icon?`<div class="si">${ico(st.icon)}</div>`:''}<div class="t">${esc(st.t)}</div><div class="d">${esc(st.d)}</div></div>`).join('')}</div></div>`,
    wuxing:s=>{const names=['木','火','土','金','水'],cx=380,cy=310,r=230;const P=names.map((n,i)=>{const a=-Math.PI/2+i*2*Math.PI/5;return [cx+r*Math.cos(a),cy+r*Math.sin(a)]});let o='';
      for(let i=0;i<5;i++){const [x1,y1]=P[i],[x2,y2]=P[(i+1)%5];const k=58/Math.hypot(x2-x1,y2-y1);o+=`<line class="lk" x1="${x1+(x2-x1)*k}" y1="${y1+(y2-y1)*k}" x2="${x2-(x2-x1)*k}" y2="${y2-(y2-y1)*k}" stroke="currentColor" stroke-width="2" marker-end="url(#ar)" style="animation-delay:${.6+i*.25}s"/>`}
      for(let i=0;i<5;i++){const [x1,y1]=P[i],[x2,y2]=P[(i+2)%5];const k=62/Math.hypot(x2-x1,y2-y1);o+=`<line x1="${x1+(x2-x1)*k}" y1="${y1+(y2-y1)*k}" x2="${x2-(x2-x1)*k}" y2="${y2-(y2-y1)*k}" stroke="currentColor" stroke-width="1.4" stroke-dasharray="6 7" opacity=".55" marker-end="url(#ar)"/>`}
      names.forEach((n,i)=>{const [x,y]=P[i];o+=`<g class="node" style="animation-delay:${.2+i*.12}s"><circle cx="${x}" cy="${y}" r="52" fill="${EL[n]}"/><g transform="translate(${x-20} ${y-30}) scale(.84)" style="color:#fff">${IC[n].replace(/<(path|circle|rect)/g,'<$1 fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"')}</g><text x="${x}" y="${y+40}" text-anchor="middle" font-size="22" font-weight="700" fill="#fff" style="fill:#fff">${n}</text></g>`});
      return `<div class="center"><div class="label a">${esc(s.label)}</div><h2 class="h2 a" style="font-size:68px">${T(s.title)}</h2><div class="wx"><svg viewBox="0 0 760 620"><defs><marker id="ar" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="currentColor"/></marker></defs>${o}</svg><div class="legend a" style="animation-delay:.8s">${s.legend.map(l=>`<div><i class="${l.dash?'dash':''}"></i><b>${esc(l.k)}</b><span>${esc(l.d)}</span></div>`).join('')}</div></div></div>`},
    bday:s=>`<div class="center"><div class="label a">${esc(s.label)}</div><h2 class="h2 a">${T(s.title)}</h2><div class="bd"><div><div class="bd-track">${s.steps.map((st,i)=>`<div class="bd-st a ${i===s.steps.length-1?'hit':''}" style="animation-delay:${.3+i*.6}s"><div class="t">${esc(st[0])}</div><div class="d">${esc(st[1])}</div></div>`).join('')}</div><div class="bd-note a" style="animation-delay:2.6s">${esc(s.note||'')}</div></div><div class="bd-year a" style="animation-delay:.2s"><span class="y0">${esc(s.from)}</span><span class="y1">${esc(s.to)}</span></div></div></div>`,
    cycle:s=>{const cx=330,cy=300,r=230;const P=[...Array(9)].map((_,i)=>{const a=-Math.PI/2+i*2*Math.PI/9;return [cx+r*Math.cos(a),cy+r*Math.sin(a)]});let o=`<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 8" opacity=".5"/>`;let seq=[],i=0;do{seq.push(P[i]);i=(i+4)%9}while(i!==0);o+=`<polygon class="lk" points="${seq.join(' ')}" fill="none" stroke="currentColor" stroke-width="1" opacity=".3" style="stroke-dasharray:4000;stroke-dashoffset:4000;animation-duration:3s"/>`;
      s.items.forEach((it,i)=>{const [x,y]=P[i];o+=`<g class="node" style="animation-delay:${.2+i*.14}s"><circle cx="${x}" cy="${y}" r="44" fill="var(--card)" stroke="${DC(it[2])}" stroke-width="4"/><text x="${x}" y="${y+16}" text-anchor="middle" font-size="44" style="font-family:var(--display)">${i+1}</text></g>`});
      return `<div class="center"><div class="label a">${esc(s.label)}</div><div style="display:grid;grid-template-columns:680px 1fr;gap:70px;align-items:center"><div class="diagram" style="height:620px;margin:0"><svg viewBox="0 0 660 600">${o}</svg></div><div><h2 class="h2 a" style="font-size:68px">${T(s.title)}</h2><div class="a" style="margin-top:34px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px 26px">${s.items.map((it,i)=>`<div style="display:flex;gap:12px;align-items:baseline;font-size:24px"><b style="font-family:var(--display);font-size:34px;color:${DC(it[2])}">${i+1}</b><span style="font-family:var(--tc);font-weight:700">${esc(it[0])}</span><span style="color:var(--mute);font-size:19px">${esc(it[1])}</span></div>`).join('')}</div></div></div></div>`}
  });

  const stage=document.getElementById('stage'),S=DECK.slides;
  let skin=new URLSearchParams(location.search).get('skin')||DECK.skin||'greige';document.body.className='skin-'+skin;
  stage.innerHTML=S.map((s,i)=>{const dark=s.dark??['cover','quote','cta'].includes(s.type);return `<section class="slide ${dark?'dark':''} ${(!dark&&i%2)?'alt':''}" data-i="${i}"><div class="head"><span class="brand">${esc(DECK.brand)}</span><span>${String(i+1).padStart(2,'0')} — ${String(S.length).padStart(2,'0')}</span></div>${(R[s.type]||R.points)(s)}<div class="foot"><span>${esc(s.label||'')}</span><span></span></div></section>`}).join('')+`<div id="bar"></div><div id="cnt"></div>`;
  const slides=[...stage.querySelectorAll('.slide')],bar=document.getElementById('bar'),cnt=document.getElementById('cnt'),notes=document.getElementById('notes'),nb=document.getElementById('notes-body'),nn=document.getElementById('notes-next'),grid=document.getElementById('grid'),gb=document.getElementById('grid-body'),hint=document.getElementById('hint');
  let c=0;
  function fit(){const k=Math.min(innerWidth/1920,innerHeight/1080);stage.style.transform=`translate(-50%,-50%) scale(${k})`}
  addEventListener('resize',fit);fit();
  function countUp(el){const raw=el.dataset.count||'';const m=raw.match(/^([^\d]*)([\d,\.]+)(.*)$/);if(!m)return;const target=parseFloat(m[2].replace(/,/g,''));if(isNaN(target))return;const dec=(m[2].split('.')[1]||'').length;const t0=performance.now(),dur=1100;const step=t=>{const p=Math.min(1,(t-t0)/dur),e=1-Math.pow(1-p,4);const v=(target*e).toFixed(dec);el.textContent=m[1]+(dec?v:Number(v).toLocaleString())+m[3];if(p<1)requestAnimationFrame(step)};requestAnimationFrame(step)}
  function restart(el){el.querySelectorAll('.a,.dither,.diagram .node,.diagram .lk,.diagram .lbl,.diagram .bar').forEach(x=>{x.style.animation='none';x.offsetHeight;x.style.animation=''});el.querySelectorAll('.w').forEach(x=>{x.style.transition='none';x.style.opacity='.18';x.offsetHeight;x.style.transition='';x.style.opacity=''})}
  function show(i){if(i<0||i>=slides.length)return;slides[c].classList.remove('on');c=i;slides[c].classList.add('on');restart(slides[c]);const st=slides[c].querySelector('.stat');if(st)countUp(st);bar.style.width=((c+1)/slides.length*100)+'%';bar.style.background=slides[c].classList.contains('dark')?'var(--onDark)':'var(--ink)';cnt.textContent='';nb.innerHTML=esc(S[c].notes||'（這頁沒有講者備註）');nn.textContent=S[c+1]?'下一頁：'+String(S[c+1].title||S[c+1].quote||S[c+1].number||'').replace(/<[^>]+>/g,''):'最後一頁';try{history.replaceState(null,'','#'+(c+1))}catch(e){}}
  const start=Math.max(0,Math.min(slides.length-1,(parseInt(location.hash.slice(1))||1)-1));slides[start].classList.add('on');c=start;show(start);
  addEventListener('keydown',e=>{if(grid.classList.contains('open')&&e.key==='Escape'){grid.classList.remove('open');return}
    if(['ArrowRight','ArrowDown',' ','PageDown'].includes(e.key)){e.preventDefault();show(c+1)}else if(['ArrowLeft','ArrowUp','PageUp'].includes(e.key)){e.preventDefault();show(c-1)}
    else if(e.key==='Home')show(0);else if(e.key==='End')show(slides.length-1);
    else if(e.key==='f'||e.key==='F'){document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen()}
    else if(e.key==='n'||e.key==='N')notes.classList.toggle('open');else if(e.key==='g'||e.key==='G')toggleGrid();
    else if(e.key==='s'||e.key==='S'){const all=['greige','midnight','aurora','pastel','bloom','sky'];skin=all[(all.indexOf(skin)+1)%all.length];document.body.className='skin-'+skin;restart(slides[c]);hint.textContent='皮膚：'+skin;hint.classList.remove('hide');clearTimeout(hint._t);hint._t=setTimeout(()=>hint.classList.add('hide'),1800);return}
    hint.classList.add('hide')});
  stage.addEventListener('click',e=>{if(e.target.closest('a'))return;const r=stage.getBoundingClientRect();(e.clientX-r.left)/r.width>.5?show(c+1):show(c-1);hint.classList.add('hide')});
  let tx=0;addEventListener('touchstart',e=>tx=e.touches[0].clientX,{passive:true});addEventListener('touchend',e=>{const d=e.changedTouches[0].clientX-tx;if(Math.abs(d)>50)d<0?show(c+1):show(c-1)});
  setTimeout(()=>hint.classList.add('hide'),7000);
  function toggleGrid(){if(grid.classList.contains('open')){grid.classList.remove('open');return}gb.innerHTML=slides.map((s,i)=>`<div class="cell ${i===c?'cur':''}" data-i="${i}" tabindex="0"><div class="mini">${s.outerHTML.replace(/class="slide/,'class="slide on')}</div><div class="num">${i+1}</div></div>`).join('');gb.querySelectorAll('.cell').forEach(el=>{const go=()=>{show(+el.dataset.i);grid.classList.remove('open')};el.onclick=go;el.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go()}}});grid.classList.add('open')}
  addEventListener('beforeprint',()=>slides.forEach(s=>s.classList.add('on')));addEventListener('afterprint',()=>slides.forEach((s,i)=>{if(i!==c)s.classList.remove('on')}));
})();
</script>
</body>
