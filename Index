.skin-greige .bokeh,.skin-greige .grainlayer,.skin-greige .glow,.skin-greige .waves,.skin-greige .bloom,.skin-greige .photo{display:none}
.skin-midnight .halftone,.skin-midnight .dither,.skin-midnight .glow,.skin-midnight .waves,.skin-midnight .bloom,.skin-midnight .photo{display:none}
