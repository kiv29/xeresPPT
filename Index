.skin-bloom .slide.dark{background:var(--bg);color:var(--ink)}
.skin-bloom .slide.dark .head,.skin-bloom .slide.dark .foot,.skin-bloom .slide.dark .label,.skin-bloom .slide.dark .lead,.skin-bloom .slide.dark .attr,.skin-bloom .slide.dark .cta-note{color:var(--mute);border-color:var(--line)}
