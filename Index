.skin-aurora .halftone,.skin-aurora .dither,.skin-aurora .bokeh,.skin-aurora .grainlayer,.skin-aurora .waves,.skin-aurora .bloom,.skin-aurora .photo{display:none}
.skin-pastel .halftone,.skin-pastel .dither,.skin-pastel .bokeh,.skin-pastel .grainlayer,.skin-pastel .glow,.skin-pastel .bloom,.skin-pastel .photo{display:none}
.skin-bloom .halftone,.skin-bloom .dither,.skin-bloom .bokeh,.skin-bloom .grainlayer,.skin-bloom .glow,.skin-bloom .waves,.skin-bloom .photo{display:none}
.skin-sky .halftone,.skin-sky .dither,.skin-sky .bokeh,.skin-sky .grainlayer,.skin-sky .glow,.skin-sky .waves,.skin-sky .bloom{display:none}
