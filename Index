.skin-bloom .bloom i{top:auto;bottom:-260px}
.skin-bloom .bloom i:nth-child(1){left:-160px}.skin-bloom .bloom i:nth-child(2){left:26%}.skin-bloom .bloom i:nth-child(3){right:-120px}.skin-bloom .bloom i:nth-child(4){left:52%;bottom:-160px}
.skin-bloom .h1 em,.skin-bloom .h2 em{color:var(--ink);opacity:.4}
